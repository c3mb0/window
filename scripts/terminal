#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v cargo >/dev/null 2>&1; then
  for toolchain_dir in "$HOME"/.rustup/toolchains/1.95.0-*/bin; do
    if [[ -x "$toolchain_dir/cargo" ]]; then export PATH="$toolchain_dir:$PATH"; break; fi
  done
fi
export MIX_REBAR3="$(command -v rebar3)"
git submodule update --init --recursive
cargo build --manifest-path vendor/play/Cargo.toml --locked
mix deps.get
mix deps.compile
npm --prefix assets ci
npm --prefix assets run build
mix compile --warnings-as-errors
export WINDOW_SERVER=1
export WINDOW_OPEN_BROWSER="${WINDOW_OPEN_BROWSER:-1}"
exec ./scripts/runtime --no-halt
